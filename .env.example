# ---------------------------------------------------------------------------
# Copy this file to .env.local for local testing, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables for production.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon / Vercel Postgres / Supabase).
# Tables are created automatically on the first request.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Any long random string. Signs the login cookie. Change this to your own.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=change-this-to-a-long-random-string

# Your UPI details. The QR code in checkout is built from these two values.
UPI_ID=yourname@okhdfcbank
UPI_NAME=Blitzz Academy

# Password for the /admin orders page.
ADMIN_PASSWORD=change-this-admin-password
